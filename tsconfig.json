{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "src/plugin.ts",
    "src/client.mjs",
    "src/isolation.mjs"
  ]
}
